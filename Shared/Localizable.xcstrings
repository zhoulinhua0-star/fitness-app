    },
    "Feedback" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意见反馈"
          }
        }
      }
    },
    "If you choose Sync to Calendar, RepDay uses Apple’s EventKit framework to create and update a dedicated workout calendar on your device. Calendar information is not transmitted to us or any third party. You can revoke calendar access in the Settings app." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你选择“同步到日历”，RepDay 会使用 Apple EventKit 在本机创建并更新独立的训练日历。日历信息不会传输给我们或任何第三方；你可以随时在系统“设置”中撤销权限。"
          }
        }
      }
    },
    "If you enable reminders or a rest timer, RepDay schedules local notifications on your device. We do not use a notification server. You can revoke notification permission in the Settings app." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用训练提醒或休息计时后，RepDay 只会在本机安排本地通知，不使用通知服务器。你可以随时在系统“设置”中撤销通知权限。"
          }
        }
      }
    },
    "International users" : {
