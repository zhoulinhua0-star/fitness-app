        }
      }
    },
    "T杠划船" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T-Bar Row"
          }
        }
      }
    },
    "When you choose to contact us, RepDay opens your email app with a draft. Nothing is sent unless you choose to send the email." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你选择联系我们时，RepDay 只会打开邮件 App 并创建草稿；除非你主动发送，否则不会传出任何内容。"
          }
        }
      }
    },
    "Workout data" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "训练数据"
          }
        }
      }
    },
    "Your optional nickname, bio, and profile photo are stored locally on your device. They are not uploaded or shared with us or any third party." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你选择设置的昵称、个性签名和头像均保存在本机，不会上传或与我们及任何第三方共享。"
          }
        }
      }
    },
    "Your plans, exercises, workout logs, and history are stored locally on your device. A small amount of workout information is shared locally with the RepDay widget through Apple’s App Groups system. It is not sent to us or any third party." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的计划、动作、训练记录与历史均保存在本机。少量训练信息会通过 Apple 的 App Groups 在本机与 RepDay 小组件共享，不会发送给我们或任何第三方。"
          }
        }
      }
    },
