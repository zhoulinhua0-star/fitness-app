    "RepDay does not require an account. We do not collect, transmit, sell, or share your personal data, and we do not use advertising, analytics, or tracking SDKs." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RepDay 无需注册账号。我们不会收集、传输、出售或共享你的个人数据，也不使用广告、分析或追踪 SDK。"
          }
        }
      }
    },
    "RepDay is not directed at children under 13 and does not knowingly collect personal information from anyone." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RepDay 不面向 13 岁以下儿童，也不会有意收集任何人的个人信息。"
          }
        }
      }
    },
    "Suggestions and feedback are always welcome." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggestions and feedback are always welcome."
          }
        }
      }
    },
    "Summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摘要"
